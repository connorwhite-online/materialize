# =============================================================================
# Materialize — environment variable reference
# Copy to .env.local and fill in real values. Never commit real values.
#
# Boot validation: validateServerEnv() in lib/env.ts (Zod, Node runtime only).
# =============================================================================

# -----------------------------------------------------------------------------
# Required at boot — app will throw EnvValidationError if any are missing.
# -----------------------------------------------------------------------------

DATABASE_URL=

# Auth — Clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Payments — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=          # local dev: value printed by `stripe listen`, NOT the dashboard secret

# Object storage — Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Transactional email — Resend
RESEND_API_KEY=

# Purchased-file watermarking (HMAC key)
WATERMARK_SECRET=

# -----------------------------------------------------------------------------
# Route-scoped — not required at boot; requests to these routes 500 without them.
# -----------------------------------------------------------------------------

CLERK_WEBHOOK_SECRET=           # required when the Clerk webhook route is hit
CRON_SECRET=                    # required for all 5 cron routes; unset → 500 fail-closed

# -----------------------------------------------------------------------------
# Optional — have defaults, but you should review them.
# -----------------------------------------------------------------------------

# Checkout model: "single" (default) or "two_step" (CON-118).
# CHECKOUT_MODEL=single

# CraftCloud mock — defaults to mock ON (any value other than exactly "false").
# Set to "false" to hit the real CraftCloud API.
# CRAFTCLOUD_USE_MOCK=false

# CraftCloud API base URL (default: https://api.craftcloud3d.com).
# CRAFTCLOUD_API_BASE_URL=

# When CRAFTCLOUD_USE_MOCK is false but you want to mock only the checkout/cart
# calls (not quotes), set this to "true".
# CRAFTCLOUD_MOCK_CHECKOUT=

# Agent billing kill switch — default OFF. Set to "true" to enable off-session
# auto-charge for MCP/agent-initiated orders (see AGENTS.md § Agent-initiated orders).
# MATERIALIZE_AGENT_BILLING_ENABLED=true

# Text-to-CAD (experimental, owner-only). Two gates, both required:
#   - kill switch, default OFF; only "true" enables the feature.
#   - comma-separated allow-list of emails that may access it. Even with the
#     kill switch on, everyone else gets a 404 and never sees the nav entry.
# TEXT_TO_CAD_ENABLED=true
# TEXT_TO_CAD_ALLOWED_EMAILS=you@example.com,teammate@example.com

# Text-to-CAD model auth. The Claude Agent SDK reads whichever is set:
#   - CLAUDE_CODE_OAUTH_TOKEN — your Claude Code subscription token (handy for
#     the private experiment; metered against your personal subscription).
#   - ANTHROPIC_API_KEY — the production-clean path; switch to this before any
#     public/multi-user exposure. With neither set, the harness falls back to a
#     deterministic local stub so the pipeline still works offline.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Text-to-CAD execution sidecar (cad-runner/). Mock is ON until you set
# CAD_RUNNER_URL — pointing at a running instance switches to live build123d
# automatically. Set CAD_RUNNER_USE_MOCK=true to force the mock even with a
# URL set (e.g. CI). Optional shared secret.
# CAD_RUNNER_URL=http://localhost:8000
# CAD_RUNNER_USE_MOCK=true
# CAD_RUNNER_SECRET=

# Text-to-CAD model routing (all optional). Each harness role resolves its
# model as: role var -> CAD_MODEL_DEFAULT -> the SDK's strong default. Leave
# everything unset to run the strong model for every role (no routing). Set a
# role var to route just that step (e.g. a cheaper planner) once telemetry +
# the scorecard justify it. CAD_PLAN_STEP=false disables the plan-then-code
# pre-pass.
# CAD_MODEL_DEFAULT=
# CAD_MODEL_PLAN=
# CAD_MODEL_IMPLEMENT=
# CAD_MODEL_REPAIR=
# CAD_MODEL_CRITIQUE=
# CAD_MODEL_TITLE=
# CAD_PLAN_STEP=false

# VLM aesthetic judge (off by default — validate the vision call + calibrate
# the threshold before enabling). CAD_AESTHETIC_JUDGE_MODEL picks a different
# model family than the generator to reduce self-preference bias.
# CAD_AESTHETIC_JUDGE=true
# CAD_AESTHETIC_JUDGE_MODEL=

# Text-to-CAD cost metering + credits substrate (MTR-181). Raw usage is ALWAYS
# recorded on cad_jobs.usage; everything money-shaped below defaults to
# off/0 = metering-only, zero behavior change. Unit prices (cents) feed the
# cad_jobs.cost_cents rollup and re-price history at read time
# (lib/billing/cad-pricing.ts):
# CAD_PRICE_MTOK_INPUT_CENTS=0
# CAD_PRICE_MTOK_OUTPUT_CENTS=0
# CAD_PRICE_MTOK_CACHE_READ_CENTS=0
# CAD_PRICE_MTOK_CACHE_WRITE_CENTS=0
# CAD_PRICE_MODEL_JSON={"claude-sonnet-4-6":{"inputCents":300,"outputCents":1500}}
# CAD_PRICE_SIDECAR_MINUTE_CENTS=0
# CAD_PRICE_FAL_CALL_CENTS=0
# CAD_PRICE_FAL_JSON={"fal-ai/hunyuan3d/v2":16,"fal-ai/flux/schnell":1}
#
# Credit ledger (default OFF — no rows are ever written without the master
# switch, and per-tier costs default to 0 even with it on):
# CAD_CREDITS_ENABLED=true
# CAD_CREDIT_COST_SIMPLE=0
# CAD_CREDIT_COST_COMPLEX=0
# CAD_CREDIT_COST_ORGANIC=0
# CAD_PRINT_THROUGH_REFUND_CREDITS=0
#
# BYOK seam (default OFF; real BYOK is blocked on MTR-187 sandbox isolation —
# there is NO user key storage yet, CAD_BYOK_STUB_KEY only exercises the
# user-key code path in tests/integration):
# CAD_BYOK_ENABLED=true
# CAD_BYOK_STUB_KEY=

# Generative 3D (fal.ai). FAL_KEY gates the whole generative path
# (lib/cad/generative.ts) — with no key, image-to-3D/text-to-3D generation
# and the concept-image aesthetic target (lib/cad/concept.ts) are both
# fully inert. Never commit a real key here.
# FAL_KEY=
# FAL_TEXT_TO_3D_MODEL=          # direct text-to-3D model, if set; default: image-to-3D via FAL_TEXT_TO_IMAGE_MODEL + FAL_IMAGE_TO_3D_MODEL
# FAL_IMAGE_TO_3D_MODEL=         # default: fal-ai/hunyuan3d/v2
# FAL_TEXT_TO_IMAGE_MODEL=       # default: fal-ai/flux/schnell
# CAD_CONCEPT_IMAGE=false        # on by default whenever FAL_KEY is set; "false" disables the concept-image step

# Text-to-CAD runtime tuning (all optional, all have defaults):
# CAD_BEST_OF=1                  # best-of-N scripted generations for a fresh build, judge picks the winner; 1-3, default 1 (off)
# CAD_AGENTIC_MAX_MS=600000      # per-run wall-clock budget for the agentic harness, default 600000 (10 min)
# CAD_MAX_QUESTIONS_PER_JOB=1    # interactive-question budget for the agentic loop, default 1
# CAD_BRIEF_STEP=false           # design-brief intermediate step; on by default, "false" skips the extra model call
# CAD_DRAFT_RETENTION_DAYS=30    # cleanup-studio-artifacts cron: draft age cutoff, default 30

# step.parts hosted STEP-file catalog (MTR-200) — GATED OFF by default; only
# enable once redistribution licensing has been confirmed for the catalog.
# CAD_STEP_PARTS_ENABLED=true
# CAD_STEP_PARTS_URL=            # default: https://api.step.parts/v1

# App URL — used for SEO meta and some email links. Stripe redirect URLs and
# MCP token pages derive from request headers instead (see AGENTS.md § Stripe
# redirect URL). Falls back to http://localhost:3000 when unset.
# NEXT_PUBLIC_APP_URL=https://materialize.cc

# From-address for transactional email (default: Materialize <noreply@materialize.cc>).
# RESEND_FROM_EMAIL=

# Operator email for dispute notifications.
# DISPUTE_NOTIFY_EMAIL=

# Sentry error monitoring.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Internal Sentry probe endpoints (dev/staging only).
# SENTRY_TEST_SECRET=
# SENTRY_TRIGGER_SECRET=
# SENTRY_TRIGGER_ALLOW_SHARED_SECRET=
# SENTRY_TRIGGER_TIMESTAMP_WINDOW_SECONDS=
# SENTRY_TRIGGER_ENVIRONMENT=
# SENTRY_INTEGRATION_CLIENT_SECRET=  # HMAC secret for the Sentry webhook signature; route is inert without this or SENTRY_TRIGGER_SECRET

# GitHub Actions dispatch (used by the Sentry PR fixer workflow).
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REPO=

# -----------------------------------------------------------------------------
# Scripts and e2e only — not read by the Next.js app.
# Playwright e2e tests load these from .env.local automatically.
# -----------------------------------------------------------------------------

# TO_EMAIL=              # scripts/email-smoke.ts recipient
# PR_NUMBER=             # scripts/pr-browser-review.ts
# PREVIEW_URL=           # scripts/pr-browser-review.ts
# PR_HEAD_SHA=           # scripts/pr-browser-review.ts
# BASE_REF=              # scripts/pr-browser-review.ts (default: main)
# MCP_PAT=               # scripts/mcp-smoke.ts

# Vercel-injected at deploy time (do not add entries here):
#   VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_GIT_COMMIT_SHA, etc.
