# =============================================================================
# Materialize — environment variable reference
# Copy to .env.local and fill in real values. Never commit real values.
#
# Boot validation: validateServerEnv() in lib/env.ts (Zod, Node runtime only).
# =============================================================================

# -----------------------------------------------------------------------------
# Required at boot — app will throw EnvValidationError if any are missing.
# -----------------------------------------------------------------------------

DATABASE_URL=

# Auth — Clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Payments — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=          # local dev: value printed by `stripe listen`, NOT the dashboard secret

# Object storage — Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Transactional email — Resend
RESEND_API_KEY=

# Purchased-file watermarking (HMAC key)
WATERMARK_SECRET=

# -----------------------------------------------------------------------------
# Route-scoped — not required at boot; requests to these routes 500 without them.
# -----------------------------------------------------------------------------

CLERK_WEBHOOK_SECRET=           # required when the Clerk webhook route is hit
CRON_SECRET=                    # required for all 5 cron routes; unset → 500 fail-closed

# -----------------------------------------------------------------------------
# Optional — have defaults, but you should review them.
# -----------------------------------------------------------------------------

# Checkout model: "single" (default) or "two_step" (CON-118).
# CHECKOUT_MODEL=single

# CraftCloud mock — defaults to mock ON (any value other than exactly "false").
# Set to "false" to hit the real CraftCloud API.
# CRAFTCLOUD_USE_MOCK=false

# CraftCloud API base URL (default: https://api.craftcloud3d.com).
# CRAFTCLOUD_API_BASE_URL=

# When CRAFTCLOUD_USE_MOCK is false but you want to mock only the checkout/cart
# calls (not quotes), set this to "true".
# CRAFTCLOUD_MOCK_CHECKOUT=

# Agent billing kill switch — default OFF. Set to "true" to enable off-session
# auto-charge for MCP/agent-initiated orders (see AGENTS.md § Agent-initiated orders).
# MATERIALIZE_AGENT_BILLING_ENABLED=true

# App URL — used for SEO meta and some email links. Stripe redirect URLs and
# MCP token pages derive from request headers instead (see AGENTS.md § Stripe
# redirect URL). Falls back to http://localhost:3000 when unset.
# NEXT_PUBLIC_APP_URL=https://materialize.cc

# From-address for transactional email (default: Materialize <noreply@materialize.cc>).
# RESEND_FROM_EMAIL=

# Operator email for dispute notifications.
# DISPUTE_NOTIFY_EMAIL=

# Sentry error monitoring.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Internal Sentry probe endpoints (dev/staging only).
# SENTRY_TEST_SECRET=
# SENTRY_TRIGGER_SECRET=
# SENTRY_TRIGGER_ALLOW_SHARED_SECRET=
# SENTRY_TRIGGER_TIMESTAMP_WINDOW_SECONDS=
# SENTRY_TRIGGER_ENVIRONMENT=

# GitHub Actions dispatch (used by the Sentry PR fixer workflow).
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REPO=

# -----------------------------------------------------------------------------
# Scripts and e2e only — not read by the Next.js app.
# Playwright e2e tests load these from .env.local automatically.
# -----------------------------------------------------------------------------

# TO_EMAIL=              # scripts/email-smoke.ts recipient
# PR_NUMBER=             # scripts/pr-browser-review.ts
# PREVIEW_URL=           # scripts/pr-browser-review.ts
# PR_HEAD_SHA=           # scripts/pr-browser-review.ts
# BASE_REF=              # scripts/pr-browser-review.ts (default: main)
# MCP_PAT=               # scripts/mcp-smoke.ts

# Vercel-injected at deploy time (do not add entries here):
#   VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_GIT_COMMIT_SHA, etc.
